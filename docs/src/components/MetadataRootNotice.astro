---
interface Props {
  legend?: string
  name: string
}

const { legend, name } = Astro.props
---

<p>
  This property can only be used in nested directories of autogenerated sidebar entries. To customize {
    legend ?? `the ${name} of the group containing autogenerated entries`
  }, use the <code>{name}</code> property in the <a
    href="https://starlight.astro.build/reference/configuration/#sidebaritem">sidebar group configuration</a
  >.
</p>
